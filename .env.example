# Suwayomi Doctor configuration. Copy this file to .env and fill it in.
# .env is git-ignored, so your addresses and passwords stay out of the repository.

# ---- Suwayomi ----
# How Doctor reaches Suwayomi. From another container on the same Docker network,
# use Suwayomi's container name (e.g. http://suwayomi:4567); otherwise its address (e.g. http://192.168.1.10:4567).
SUWAYOMI_URL=http://suwayomi:4567
# The address your browser uses to open Suwayomi. "Migrate in Suwayomi" links point here.
# Leave empty to use SUWAYOMI_URL.
SUWAYOMI_PUBLIC_URL=
# none | basic_auth | simple_login | ui_login (matches Suwayomi's AUTH_MODE)
SUWAYOMI_AUTH_MODE=none
SUWAYOMI_USERNAME=
SUWAYOMI_PASSWORD=

# ---- Scans (defaults; the Settings dialog can override them) ----
# Cron schedule, in TZ. Default: Sundays at 04:00.
SCAN_CRON=0 4 * * 0
# Days with no new chapter before an ongoing series is called stale.
STALE_DAYS=90
# Sources checked in parallel, and the pause between two series on the same source.
SOURCE_CONCURRENCY=3
REQUEST_DELAY_MS=2000
# How long to wait for one series to refresh.
REFRESH_TIMEOUT_MS=120000
# Also check series from Suwayomi's Local source.
INCLUDE_LOCAL_SOURCE=false

# ---- Docker ----
# Image to run. GitHub Actions publishes ghcr.io/<github-user>/<repo>:latest on every push
# to main, so a fork can point this at its own image.
DOCTOR_IMAGE=ghcr.io/sjeongus/suwayomi-doctor:latest
# Time zone for the schedule and logs (a tz database name).
TZ=UTC
# Port Doctor is published on.
DOCTOR_PORT=4568
# Where doctor.db lives: a named volume (default) or a folder on the host, e.g. /srv/suwayomi-doctor/data.
DOCTOR_DATA=doctor-data
# User and group Doctor runs as. With a host folder in DOCTOR_DATA, use the folder's owner (`id` shows yours).
PUID=1000
PGID=1000
